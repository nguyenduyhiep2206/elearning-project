# DOCKERFILE KHONG AN TOAN - DUNG DE DEMO

# Dung full image - qua nang, nhieu lo hong
FROM node:20

# Khong tao user rieng - chay voi root
WORKDIR /app

# Copy tat ca file, ke ca .env, .git
COPY . .

# Khong dung --production, cai ca devDependencies
RUN npm install

# Khong set NODE_ENV
# Khong co health check 
# health check la mot chuc nang quan trong de kiem tra xem container co chay duoc khong
EXPOSE 3000

# Chay voi quyen root (mac dinh)
CMD ["npm", "run", "dev"]
